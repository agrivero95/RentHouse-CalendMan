generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TimeSlotType {
  AVAILABLE
  RESERVED
  BLOCKED
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  READ
}

model Owner {
  id        String   @id @default(uuid()) @db.Uuid()
  email     String   @unique
  phone     String
  name      String
  lastName1 String
  lastName2 String?  @db.VarChar(100)
  picture   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("owners")
}

model Property {
  id          String   @id @default(uuid()) @db.Uuid()
  ownerId     String   @db.Uuid()
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address     String
  description String?  @db.Text
  pictures    String?  @db.JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  travelTimeFrom TravelTime[] @relation("PropertyToProperty")
  travelTimeTo   TravelTime[] @relation("PropertyToProperty")

  @@map("properties")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid()
  name      String
  lastName1 String
  lastName2 String?  @db.VarChar(100)
  email     String
  phone     String
  picture   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@map("clients")
}

model Appointment {
  id           String             @id @default(uuid()) @db.Uuid()
  createdAt    DateTime           @default(now())
  dateSet      DateTime
  timeSet      DateTime
  duration     Int               @default(15)
  clientId     String             @db.Uuid()
  propertyId   String             @db.Uuid()
  status       AppointmentStatus  @default(PENDING)
  notes        String?            @db.Text
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([clientId, dateSet, timeSet])
  @@index([dateSet, timeSet])
  @@index([propertyId, dateSet])
  @@map("appointments")
}

model TimeSlot {
  id          String        @id @default(uuid()) @db.Uuid()
  propertyId  String        @db.Uuid()
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  type        TimeSlotType  @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date, startTime])
  @@index([propertyId, date])
  @@map("time_slots")
}

model TravelTime {
  id            String   @id @default(uuid()) @db.Uuid()
  propertyId1   String   @db.Uuid()
  propertyId2   String   @db.Uuid()
  duration      Int      @default(15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propertyFrom  Property @relation("PropertyToProperty", fields: [propertyId1], references: [id], onDelete: Cascade)
  propertyTo    Property @relation("PropertyToProperty", fields: [propertyId2], references: [id], onDelete: Cascade)

  @@unique([propertyId1, propertyId2])
  @@map("travel_times")
}

model AdminUser {
  id        String   @id @default(uuid()) @db.Uuid()
  username  String   @unique
  password  String
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid()
  appointmentId String         @db.Uuid()
  recipientId String           @db.Uuid()
  recipientType String         @db.VarChar(20)
  type        NotificationType @default(SYSTEM)
  title       String
  message     String           @db.Text
  status      NotificationStatus @default(PENDING)
  data        String?          @db.JSON
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([recipientId, recipientType])
  @@index([appointmentId])
  @@index([status])
  @@map("notifications")
}

model EmailLog {
  id          String   @id @default(uuid()) @db.Uuid()
  to          String
  subject     String
  body        String   @db.Text
  appointmentId String? @db.Uuid()
  status      String   @default("pending")
  error       String?  @db.Text
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([status])
  @@map("email_logs")
}

model ConfirmationToken {
  id          String   @id @default(uuid()) @db.Uuid()
  appointmentId String @db.Uuid()
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  usedAt      DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("confirmation_tokens")
}

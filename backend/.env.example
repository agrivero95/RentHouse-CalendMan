# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rent_house_calendman?schema=public"

# Prisma
PRISMA_SCHEMA=src/prisma/schema.prisma

# Server
PORT=3000
API_PREFIX=api

# JWT
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_EXPIRATION=86400

# CORS
CORS_ORIGIN=http://localhost:3001

# App
APP_NAME=RentHouse CalendMan
APP_DESCRIPTION=Property Rent Management Calendar System

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=RentHouse CalendMan <noreply@renthouse-calendman.com>
FRONTEND_URL=http://localhost:3001

# Email Reminders
REMINDER_ENABLED=true
REMINDER_INTERVAL_MINUTES=5
REMINDER_MINUTES_BEFORE=30

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
